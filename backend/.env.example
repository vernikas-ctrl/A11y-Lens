# A11y-Lens backend configuration — EXAMPLE VALUES ONLY.
#
# Setup:
#   1. cp .env.example .env        (from inside backend/)
#   2. fill in the two secrets below
#
# .env is git-ignored. This file is committed, and must never contain a real
# key or a real access code. If you change a setting name in app/config.py,
# change it here too — this file is the only list of what the app reads.


# ── Secrets: required. The server will not start without them. ──────────────

# Your Claude API key, from console.anthropic.com → API keys.
# Leave as the placeholder while working through Phases 2–4: nothing calls
# Claude until Phase 5. The server warns but still starts.
# ENVIRONMENT=production refuses to start on the placeholder.
ANTHROPIC_API_KEY=paste-your-anthropic-api-key-here

# The shared code that unlocks live scanning. Anyone with this can spend your
# API budget, so treat it like a password. Minimum 12 characters.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(16))"
ACCESS_CODE=change-me-to-something-long-and-random


# ── Everything below has a sensible default and can be left out. ────────────

# Origins the browser is allowed to call this API from. Comma-separated, no
# spaces needed. 5173 is Vite's dev server. In production this becomes your
# Vercel URL and nothing else.
#
# Gotcha: http://localhost:5173 and http://127.0.0.1:5173 are DIFFERENT origins
# to a browser. Opening the frontend on the other one gives "Failed to fetch"
# with no explanation. List both if you switch between them.
ALLOWED_ORIGINS=http://localhost:5173

# How long one page may take to load before the scan gives up, milliseconds.
# Between 1000 and 120000.
SCAN_TIMEOUT_MS=30000

# Hard ceiling on scans per day, across everyone. This is the backstop that
# limits the damage if the access code leaks. 0 disables live scanning.
#
# The app is link-only — shared with people you choose, not posted publicly —
# so this does not need to be large. 15 covers a handful of known people
# comfortably, and a smaller ceiling is a smaller worst case if the link gets
# forwarded. Raise it when you actually run out.
DAILY_SCAN_LIMIT=15

# development or production.
ENVIRONMENT=development

# ── Phase 5: the explanation call ──────────────────────────────────────────

# Which model writes the explanations. This is a cost dial, which is why it
# lives here and not in the code: $4/$20 per million tokens for Opus 5.5,
# $2/$10 for claude-sonnet-5-5, $0.10/$0.50 for claude-haiku-5-5.
ANTHROPIC_MODEL=claude-opus-5-5

# How much the model thinks before answering: low, medium, high, xhigh, max.
# Thinking is billed as output, so this is the second cost dial. Explaining an
# accessibility rule is a bounded job and does not need deep reasoning.
ANTHROPIC_EFFORT=low

# How long the explanation call may take before the scan gives up on it and
# returns the findings with explanations marked unavailable. A slow answer is
# worse than no answer here: the findings are already useful on their own.
EXPLAIN_TIMEOUT_MS=60000
