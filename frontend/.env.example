# Copy this file to `.env` and fill in the real values.
#
#     cp .env.example .env
#
# `.env` is git-ignored. This file is committed, and must never contain a real
# access code.
#
# Vite only exposes variables whose names start with VITE_, and it substitutes
# them when the app is BUILT. Two consequences:
#
#   1. Adding a variable while `npm run dev` is running does nothing until the
#      dev server is restarted.
#   2. Everything here ends up inside the built JavaScript, which anybody who
#      can load the page can read. See the note on VITE_ACCESS_CODE below.

# Where the backend is.
#
# Leave it as the local backend for development. Task 10.4 sets this to the
# deployed backend's address in Vercel's own settings, not in a committed file.
# Trailing slashes are stripped, so either form works.
VITE_API_BASE_URL=http://127.0.0.1:8000

# The shared access code, which must match ACCESS_CODE in backend/.env.
#
# *** THIS IS NOT A SECRET IN THE WAY THE BACKEND'S API KEY IS A SECRET. ***
#
# It is compiled into the JavaScript the browser downloads, so anybody who
# opens developer tools can read it. What it buys is that the link is not
# casually usable by a stranger who comes across it -- which is what
# "link-only" means here, and is what it was chosen for. It is not protection
# against somebody who wants in.
#
# Setting it here is a convenience for development. In production it is
# normally left unset, and task 8.0's code screen asks the person for it
# instead -- same weakness, but at least the code is not sitting in the bundle
# of a link that gets forwarded.
VITE_ACCESS_CODE=replace-with-the-code-from-backend-dot-env
